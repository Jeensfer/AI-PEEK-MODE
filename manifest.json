{
  "manifest_version": 3,
  "name": "AI Mode Peek",
  "version": "3.0",
  "description": "Select text and see Google AI Mode's answer in a small window next to your cursor, using your signed-in Chrome.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AI Mode Peek" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
